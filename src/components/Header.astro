---
import { translations } from "../i18n/translations.js";

const t = translations.es;
---

<header class="header">
  <nav
    class="nav"
    aria-label={t.nav_main}
    data-i18n-aria-label="nav_main"
  >
    <a href="#presentacion" data-i18n="nav_home">{t.nav_home}</a>
    <a href="#projects" data-i18n="nav_projects">{t.nav_projects}</a>
    <a href="#academic-background" data-i18n="nav_education">
      {t.nav_education}
    </a>
    <a href="#about-me" data-i18n="nav_about">{t.nav_about}</a>
    <button type="button" class="mail-btn nav-mail-btn" data-i18n="nav_contact">
      {t.nav_contact}
    </button>
    <button
      type="button"
      id="lang-toggle"
      class="lang-toggle"
      aria-label={t.lang_switch_label}
      aria-pressed="false"
    >
      <span class="lang-option lang-option-es">ES</span>
      <span class="lang-option lang-option-en">EN</span>
    </button>
    <button
      type="button"
      id="theme-toggle"
      class="theme-toggle"
      aria-label={t.theme_switch_light}
      aria-pressed="false"
      title={t.theme_switch_light}
    >
      <svg
        class="icon icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg
        class="icon icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </nav>
</header>
